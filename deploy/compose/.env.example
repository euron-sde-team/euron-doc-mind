# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
DOCMIND_SESSION_SECRET=replace-with-output-of-make-env
DOCMIND_API_KEY_PEPPER=replace-with-output-of-make-env
DOCMIND_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional: answers written by a model instead of the offline extractive answerer
# DOCMIND_LLM_PROVIDER=ollama            # or openai: any OpenAI-compatible API
# DOCMIND_LLM_MODEL=llama3.2
# DOCMIND_OLLAMA_URL=http://host.docker.internal:11434
# DOCMIND_LLM_BASE_URL=https://api.openai.com/v1
# DOCMIND_LLM_API_KEY=

# Optional overrides
# DOCMIND_PRODUCT_NAME=Euron DocMind
# DOCMIND_LOG_LEVEL=info
# DOCMIND_WEB_PORT=3110
# DOCMIND_API_PORT=8110
# DOCMIND_PG_PORT=5451
# DOCMIND_REDIS_PORT=6411
# DOCMIND_FLOCI_PORT=4611
